// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum Role {
  PATIENT
  PROVIDER
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum NotificationType {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  PROVIDER_REGISTER
  PROVIDER_VERIFY
  PROVIDER_SUSPEND
  RECORD_ACCESS
  ADMIN_SETTINGS_UPDATE
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  TRIAGE_CONSENT_GRANTED
  TRIAGE_CONSENT_WITHDRAWN
  PROVIDER_SOURCE_CHANGE
  PROVIDER_SCRAPE_RUN
  PROVIDER_CANDIDATE_REVIEW
  PROVIDER_CANDIDATE_PUBLISH
  ACCOUNT_DELETED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PrescriptionStatus {
  PENDING
  ROUTED
  FULFILLED
}

enum UserNotificationType {
  MENTION_POST
  MENTION_COMMENT
  FOLLOW
  MESSAGE
  APPOINTMENT_BOOKED
  APPOINTMENT_UPDATED
  APPOINTMENT_REMINDER
  COMMUNITY_LIKE
  COMMUNITY_COMMENT
  REFERRAL_UPDATE
  PERIOD_REMINDER
  SYSTEM
}

// --- Core Models ---
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phoneNumber     String?   @unique
  passwordHash    String
  dateOfBirth     DateTime?
  role            Role      @default(PATIENT)
  privacyConsent  Boolean   @default(false)
  handle          String?   @unique
  isVerified      Boolean   @default(false)
  isEmailVerified Boolean   @default(false)
  // Required by the NextAuth PrismaAdapter contract (Magic Link). Distinct from
  // isEmailVerified above — that field drives our own app logic; this one only
  // exists so the adapter's updateUser() call doesn't fail on unknown fields.
  emailVerified   DateTime?
  avatarUrl       String?
  lastSeenAt      DateTime? // presence: updated while the realtime stream is open
  googlePhotoUrl  String? // latest Google profile photo, synced at Google sign-in
  deletedAt       DateTime? // account closed by the patient (anonymised soft delete)

  // Geographic / contact identity fields — nullable for backward compat with
  // pre-existing rows; enforced as required at the application layer for new signups.
  country String?

  // Provider-editable professional fields (self-reported; not admin-verified)
  licenseNumber       String?
  hospitalAffiliation String?
  secondaryEmail      String?

  // AI triage consent (Rwanda Law N° 058/2021). Explicit, granular and
  // versioned: the gate treats consent as valid only when both flags are
  // true, consentTimestamp is set, and consentVersion matches the current
  // notice version. Every grant and withdrawal is also written to AuditLog.
  hasConsentedToPrivacy Boolean   @default(false)
  hasConsentedToTriage  Boolean   @default(false)
  consentTimestamp      DateTime?
  consentVersion        String?   @default("2026.1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patientProfile          PatientProfile?
  practitionerProfile     PractitionerProfile?
  symptomChecks           SymptomCheck[]
  notifications           Notification[]
  providerProfile         ProviderProfile?
  auditLogs               AuditLog[]
  resetTokens             ResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  accounts                Account[]
  sessions                Session[]
  feedback                Feedback[]
  insurance               PatientInsurance?
  reminderPreference      ReminderPreference?
  loginChallenges         LoginChallenge[]
  reminderDispatches      ReminderDispatch[]
  referrals               Referral[]
  activities              PatientActivity[]

  // Social graph — rows where I'm the follower / the one being followed
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  // Legacy messaging (Message model)
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  // Direct messaging (appointment-gated)
  sentDirectMessages     DirectMessage[] @relation("DMSender")
  receivedDirectMessages DirectMessage[] @relation("DMReceiver")

  // Prescription relations
  patientPrescriptions  Prescription[] @relation("PatientPrescriptions")
  providerPrescriptions Prescription[] @relation("ProviderPrescriptions")

  // In-app notification relations
  receivedNotifications UserNotification[] @relation("NotificationRecipient")
  sentNotifications     UserNotification[] @relation("NotificationActor")

  // Community Relations
  communityPosts    CommunityPost[]    @relation("PostAuthor")
  communityComments CommunityComment[] @relation("CommentAuthor")
  communityLikes    CommunityLike[]
  communityStories  CommunityStory[]   @relation("StoryAuthor")

  // Provider availability slots
  availability ProviderAvailability[]
}

model PatientProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country          String
  menstrualCycle   String?
  emergencyContact String?

  healthGoals String[] @default([])

  // Relations
  cycleLogs     CycleLog[]
  cycleDayLogs  CycleDayLog[]
  habitLogs     HabitLog[]
  healthRecords HealthRecord[] @relation("PatientHealthRecords")
  appointments  Appointment[]  @relation("PatientAppointments")
}

model PractitionerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  location        String?
  clinicName      String
  specialty       String // e.g., "Endocrinologist", "Gynecologist"
  bio             String?
  yearsExperience Int?
  // Practice coordinates for the patient map (geocoded from `location`).
  latitude        Float?
  longitude       Float?
  isVerified      Boolean @default(false) // Admin approval flag
  isActive        Boolean @default(true) // Soft-delete flag — false once an admin "deletes" the provider

  appointments  Appointment[]  @relation("DoctorAppointments")
  healthRecords HealthRecord[] @relation("ProviderHealthRecords")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Healthcare Feature Models ---
model SymptomCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json
  riskLevel String
  createdAt DateTime @default(now())
}

model Appointment {
  id String @id @default(cuid())

  patientProfileId String
  patient          PatientProfile @relation("PatientAppointments", fields: [patientProfileId], references: [id], onDelete: Cascade)

  practitionerProfileId String
  practitioner          PractitionerProfile @relation("DoctorAppointments", fields: [practitionerProfileId], references: [id], onDelete: Cascade)

  // Scheduling details
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(SCHEDULED)

  // Telehealth & clinical data
  meetingLink String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]

  reminderSentAt DateTime? // 24-hour reminder sent (idempotency for the reminder sweep)

  @@index([patientProfileId])
  @@index([practitionerProfileId])
  @@index([startTime])
}

model HealthRecord {
  id String @id @default(cuid())

  patientProfileId String
  patient          PatientProfile @relation("PatientHealthRecords", fields: [patientProfileId], references: [id], onDelete: Cascade)

  practitionerProfileId String
  practitioner          PractitionerProfile @relation("ProviderHealthRecords", fields: [practitionerProfileId], references: [id], onDelete: Cascade)

  // Record Details
  type        String
  documentUrl String?
  notes       String?
  content     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientProfileId])
  @@index([practitionerProfileId])
}

// --- Communication Models ---
model Message {
  id         String @id @default(cuid())
  senderId   String
  sender     User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Appointment-gated 1-on-1 direct messaging between patients and providers.
model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

model Notification {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  status      NotificationStatus @default(PENDING)
  message     String
  scheduledAt DateTime?
  createdAt   DateTime           @default(now())
}

// --- Platform Resources ---
model Pharmacy {
  id           String   @id @default(cuid())
  name         String
  address      String
  contactEmail String?
  tags         String[]
  createdAt    DateTime @default(now())

  // Prescriptions where this pharmacy was chosen by the patient
  prescriptions Prescription[] @relation("PharmacyFilled")

  // Prescriptions where a provider suggested this pharmacy
  suggestedPrescriptions Prescription[] @relation("PharmacySuggested")
}

model Article {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String?
  tags        String[]
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

model CycleLog {
  id               String         @id @default(cuid())
  patientProfileId String
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  startDate    DateTime
  endDate      DateTime?
  cycleLength  Int?
  periodLength Int?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientProfileId])
}

model HabitLog {
  id               String         @id @default(cuid())
  patientProfileId String
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  habitId   Int
  date      DateTime @db.Date
  completed Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientProfileId, habitId, date])
  @@index([patientProfileId, date])
}

model ProviderProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  specialty          String
  licenseNumber      String             @unique
  verificationStatus VerificationStatus @default(PENDING)

  verifiedAt   DateTime?
  verifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Availability slots that providers publish for booking.
model ProviderAvailability {
  id          String   @id @default(cuid())
  providerId  String
  provider    User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  startTime   String // "HH:MM" 24-hour
  endTime     String // "HH:MM" 24-hour
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([providerId, date, startTime, endTime])
  @@index([providerId])
  @@index([date])
}

model ResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── NextAuth PrismaAdapter models (Magic Link / EmailProvider) ───────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  actorId   String
  targetId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime    @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

// --- Community Models ---

model CommunityPost {
  id        String     @id @default(cuid())
  content   String
  mediaUrl  String?
  mediaType MediaType?
  authorId  String
  author    User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  repostOfId String?
  repostOf   CommunityPost?  @relation("Reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts    CommunityPost[] @relation("Reposts")

  comments      CommunityComment[]
  likes         CommunityLike[]
  notifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model CommunityComment {
  id       String        @id @default(cuid())
  content  String
  postId   String
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  notifications UserNotification[]

  createdAt DateTime @default(now())

  @@index([postId])
}

model CommunityLike {
  id     String        @id @default(cuid())
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Prescription {
  id             String             @id @default(cuid())
  medicationName String
  dosage         String
  instructions   String?
  status         PrescriptionStatus @default(PENDING)

  patientId String
  patient   User   @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)

  providerId String
  provider   User   @relation("ProviderPrescriptions", fields: [providerId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Pharmacy the patient actually routed to
  pharmacyId String?
  pharmacy   Pharmacy? @relation("PharmacyFilled", fields: [pharmacyId], references: [id], onDelete: SetNull)

  // Pharmacy the provider suggests the patient route to
  suggestedPharmacyId String?
  suggestedPharmacy   Pharmacy? @relation("PharmacySuggested", fields: [suggestedPharmacyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([providerId])
  @@index([pharmacyId])
  @@index([suggestedPharmacyId])
}

model UserNotification {
  id          String               @id @default(cuid())
  recipientId String
  recipient   User                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // Null for system notifications (reminders, referral updates).
  actorId     String?
  actor       User?                @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  title       String?
  body        String?
  link        String? // in-app path to open, e.g. /dashboard/messages
  type        UserNotificationType
  postId      String?
  post        CommunityPost?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId   String?
  comment     CommunityComment?    @relation(fields: [commentId], references: [id], onDelete: SetNull)
  isRead      Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([recipientId])
  @@index([recipientId, isRead])
}

model CommunityStory {
  id        String   @id @default(cuid())
  content   String?
  imageUrl  String?
  authorId  String
  author    User     @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([authorId])
  @@index([expiresAt])
}

enum FeedbackCategory {
  GENERAL
  CLINICAL_TRIAGE
  REFERRALS_BOOKING
  BUG_REPORT
  FEATURE_REQUEST
  // Legacy values, no longer offered in the form; kept so historical rows stay valid.
  PROVIDER_EXPERIENCE
  BILLING
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

model Feedback {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating   Int
  category FeedbackCategory @default(GENERAL)
  comment  String
  status   FeedbackStatus   @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([category])
}

// --- Hospital Referrals & Insurance ---

enum InsuranceProvider {
  RSSB_RAMA
  MMI
  RADIANT
  SANLAM
  BRITAM
  UAP_OLD_MUTUAL
  EDENCARE
  OTHER_PRIVATE
  NONE_CASH
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
  EXPIRED
}

model PatientInsurance {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          InsuranceProvider @default(NONE_CASH)
  otherProviderName String? // insurer name when provider = OTHER_PRIVATE
  policyNumber      String?
  principalMember   String?
  expiryDate        DateTime?
  cardPhotoUrl      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Hospital {
  id                  String              @id @default(cuid())
  name                String // e.g., "King Faisal Hospital", "CHUK", "Kacyiru District Hospital"
  address             String
  district            String // e.g., "Gasabo", "Nyarugenge", "Kicukiro"
  phone               String
  latitude            Float?
  longitude           Float?
  supportedInsurances InsuranceProvider[]
  referrals           Referral[]
  createdAt           DateTime            @default(now())

  @@unique([name, district])
}

model Referral {
  id                String          @id @default(cuid())
  patientId         String
  patient           User            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId        String
  hospital          Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialtyRequired String // e.g., "Obstetrics & Gynecology", "General Practitioner"
  clinicalReason    String          @db.Text
  triageSeverity    String // "LOW", "MODERATE", "URGENT"
  insuranceSnapshot Json? // Frozen insurance snapshot at the time of referral
  referralCode      String          @unique // Unique short code e.g. "NC-REF-8942"
  status            ReferralStatus  @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  shares            ReferralShare[]

  @@index([patientId])
  @@index([hospitalId])
}

// --- Pre-launch waitlist (public form at /waitlist) ---

enum WaitlistRole {
  PATIENT
  PROVIDER
  ORGANIZATION
  OTHER
}

model WaitlistEntry {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique // stored lower-cased; one signup per address
  phone     String?
  country   String?
  role      WaitlistRole @default(PATIENT)
  interest  String?      @db.Text // optional "what would you like from NauriCare?"
  source    String? // e.g. utm_source or referrer path
  consentAt DateTime // explicit consent to be contacted (Law Nº 058/2021)
  ipAddress String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([role])
}

// --- Provider sourcing pipeline (public web pages -> admin review -> invite) ---
//
// Scraped doctors are prospects, not providers. A candidate becomes a bookable
// provider only after an admin approves it AND the doctor consents: either by
// claiming the invitation, or via an admin-recorded offline attestation.

enum ProviderScrapeStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProviderCandidateStatus {
  PENDING_REVIEW // extracted, waiting for an admin
  INVITED // approved; invitation sent, waiting for the doctor to accept
  PUBLISHED // live, bookable provider account exists
  REJECTED
  DUPLICATE
}

enum ProviderConsentSource {
  INVITE_CLAIMED // the doctor accepted the invitation themselves
  ADMIN_ATTESTED // an admin recorded consent obtained offline
}

model ProviderSource {
  id          String    @id @default(cuid())
  name        String // e.g. "King Faisal Hospital - Our Doctors"
  url         String    @unique // https page to start crawling from
  notes       String?
  isActive    Boolean   @default(true)
  createdById String
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs       ProviderScrapeRun[]
  candidates ProviderCandidate[]
}

model ProviderScrapeRun {
  id              String               @id @default(cuid())
  sourceId        String
  source          ProviderSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status          ProviderScrapeStatus @default(QUEUED)
  triggeredById   String
  pagesFetched    Int                  @default(0)
  candidatesFound Int                  @default(0)
  log             String?              @db.Text // human-readable progress / warnings
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime             @default(now())

  candidates ProviderCandidate[]

  @@index([sourceId, createdAt])
}

model ProviderCandidate {
  id        String             @id @default(cuid())
  sourceId  String
  source    ProviderSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  runId     String?
  run       ProviderScrapeRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  dedupeKey String             @unique // normalised email, else name + facility

  fullName         String
  specialty        String
  email            String?
  phone            String?
  yearsExperience  Int?
  facilityName     String?
  practiceLocation String?
  latitude         Float?
  longitude        Float?
  photoSourceUrl   String? // original image URL on the source site (admin preview only)
  profileUrl       String // page the details were found on
  evidence         String  @db.Text // verbatim text the fields came from
  confidence       Float   @default(0)
  extractor        String // "ai" | "heuristic"

  status       ProviderCandidateStatus @default(PENDING_REVIEW)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  inviteTokenHash String?   @unique // SHA-256 of the raw invite token
  inviteExpiresAt DateTime?
  invitedAt       DateTime?

  consentSource     ProviderConsentSource?
  consentRecordedAt DateTime?
  consentNote       String?
  publishedUserId   String?                @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// --- Hospital referral sharing (opaque link -> encrypted snapshot) ---
//
// The URL holds only a random token; we store its SHA-256 hash. The patient
// data is an AES-256-GCM encrypted snapshot, unlocked by the hospital with the
// patient's referral code as a second factor. Every attempt is logged.

model ReferralShare {
  id               String    @id @default(cuid())
  referralId       String
  referral         Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  encryptedPayload String    @db.Text
  payloadVersion   Int       @default(1)
  expiresAt        DateTime
  revokedAt        DateTime?
  failedAttempts   Int       @default(0)
  accessCount      Int       @default(0)
  lastAccessedAt   DateTime?
  createdAt        DateTime  @default(now())

  accesses ReferralShareAccess[]

  @@index([referralId])
}

model ReferralShareAccess {
  id        String        @id @default(cuid())
  shareId   String
  share     ReferralShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([shareId, createdAt])
}

// --- Patient activity history (shown in the Records tab) ---

enum PatientActivityType {
  AI_TRIAGE
  APPOINTMENT_BOOKED
  REFERRAL_CREATED
  REFERRAL_SHARED
  REFERRAL_SHARE_REVOKED
  REFERRAL_SHARE_OPENED
  INSURANCE_UPDATED
  CONSENT_GRANTED
  CONSENT_WITHDRAWN
  CYCLE_LOGGED
  PRESCRIPTION_ROUTED
  FEEDBACK_SUBMITTED
  SIGNED_IN
  PROFILE_UPDATED
}

model PatientActivity {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PatientActivityType
  title     String
  details   Json? // e.g. AI prompt + response for AI_TRIAGE; never secrets
  refType   String? // "SymptomCheck" | "Appointment" | "Referral" | ...
  refId     String?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
}

// Patient reminder settings (Settings > Reminders). Delivery state lives in
// ReminderDispatch (the idempotency ledger), not here.
model ReminderPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodReminders      Boolean @default(true)
  periodLeadDays       Int     @default(2) // notify this many days before the predicted start
  dailyLogReminders    Boolean @default(false)
  weeklyInsights       Boolean @default(false)
  appointmentReminders Boolean @default(true)
  emailEnabled         Boolean @default(true) // in-app is always on; email is opt-out
  reminderHour         Int     @default(19) // local hour (0-23) for daily and weekly nudges
  timezone             String  @default("Africa/Kigali")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FlowLevel {
  NONE
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

// One row per patient per day (Flo-style daily log): flow, symptoms, mood.
model CycleDayLog {
  id               String         @id @default(cuid())
  patientProfileId String
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  date     DateTime   @db.Date
  flow     FlowLevel?
  symptoms String[]   @default([])
  moods    String[]   @default([])
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientProfileId, date]) // also serves date-range lookups
}

// Sign-in verification codes (second step after every sign-in). Only a keyed
// hash of the 6-digit code is stored. `sessionKeyHash` binds the challenge
// to one signed-in browser session, so a code can't unlock another session.
model LoginChallenge {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKeyHash String
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime? // correct code entered
  consumedAt     DateTime? // used to unlock the session (one time)
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([sessionKeyHash])
}

enum ReminderDispatchStatus {
  CLAIMED
  SENT
  FAILED
}

// Idempotency ledger for scheduled reminders. One row per reminder
// (dedupeKey, e.g. "period:<userId>:2026-11-02"). A run claims a row
// atomically, delivers, then marks it SENT. Failed or abandoned claims
// (lease older than 15 min) are retried, up to 5 attempts. Each delivery step
// is recorded so a retry never repeats a step that already succeeded.
model ReminderDispatch {
  id         String                 @id @default(cuid())
  dedupeKey  String                 @unique
  kind       String // period | daily | weekly | appointment | appointment-provider
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     ReminderDispatchStatus @default(CLAIMED)
  attempts   Int                    @default(1)
  claimedAt  DateTime               @default(now())
  notifiedAt DateTime? // in-app notification created
  emailedAt  DateTime? // email accepted by the provider
  sentAt     DateTime? // all steps done
  lastError  String?
  createdAt  DateTime               @default(now())

  @@index([status, claimedAt])
  @@index([userId])
}
