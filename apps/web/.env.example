# Copy to .env.local and fill in. Never commit real values.
# Matches docker-compose.yml (local only)
DATABASE_URL=postgresql://nauricare_admin:securepassword@localhost:5433/nauricare
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (test keys always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# AI triage: MedGemma (OpenAI-compatible) first, Gemini as fallback
MEDGEMMA_ENDPOINT_URL=
MEDGEMMA_API_KEY=
MEDGEMMA_MODEL=google/medgemma-27b-text-it
GEMINI_API_KEY=

# Sealing key for share payloads/claim tokens. Set explicitly in production; never rotate without a plan.
DATA_ENCRYPTION_KEY=

# Reminders: EventBridge calls /api/cron/execute in production; `on` runs in-process locally.
CRON_SECRET=
REMINDER_SCHEDULER=off

# Development only: print sign-in codes to the server log
LOGIN_CODE_DEV_LOG=1

# Observability (all optional). Logs are JSON on stdout; see src/lib/logger.ts.
# LOG_LEVEL=debug
# APP_ENV=development
# Export Next.js traces over OTLP (e.g. to an ADOT collector / X-Ray):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=nauricare-web

# User media (S3). On ECS the task role supplies credentials, so the keys are
# only for local development against a real bucket.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
